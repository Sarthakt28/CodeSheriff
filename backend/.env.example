# ── CodeSheriff Backend — Environment Variables ───────────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git (it's in .gitignore).
#
# Usage:  cp .env.example .env

# ── GitHub OAuth App ──────────────────────────────────────────────────────────
# Create at: https://github.com/settings/applications/new
# Homepage URL:  http://localhost:5173
# Callback URL:  http://localhost:5173/auth/callback
GITHUB_CLIENT_ID=PASTE_YOUR_GITHUB_CLIENT_ID_HERE
GITHUB_CLIENT_SECRET=PASTE_YOUR_GITHUB_CLIENT_SECRET_HERE

# ── GitHub Webhook ────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=PASTE_A_RANDOM_32CHAR_SECRET_HERE

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=PASTE_A_RANDOM_JWT_SECRET_HERE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev:  sqlite:///./codesheriff.db   (no Postgres needed)
# Production: postgresql://USER:PASSWORD@HOST:5432/codesheriff
DATABASE_URL=sqlite:///./codesheriff.db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── ML Reviewer ───────────────────────────────────────────────────────────────
# false = fast startup (rules only)
# true  = also runs SentenceTransformer (~90 MB download on first use)
USE_ML_REVIEWER=false
# ML_MODEL_NAME=all-MiniLM-L6-v2

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173
